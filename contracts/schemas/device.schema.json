{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simtrouble.local/schemas/device.schema.json",
  "title": "Device",
  "description": "V0 industrial robot flexible handling workstation identity and fixed component boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "device_type", "scenario", "display_name", "components"],
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "device_type": {
      "const": "industrial_robot"
    },
    "scenario": {
      "const": "flexible_handling"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["robot_arm", "gripper", "workpiece", "target_area", "obstacle"]
      }
    }
  },
  "examples": [
    {
      "device_id": "DEV-IR-FH-001",
      "device_type": "industrial_robot",
      "scenario": "flexible_handling",
      "display_name": "工业机器人柔性搬运工作站",
      "components": ["robot_arm", "gripper", "workpiece", "target_area", "obstacle"]
    }
  ]
}
