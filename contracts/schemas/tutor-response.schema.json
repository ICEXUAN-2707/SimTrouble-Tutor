{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simtrouble.local/schemas/tutor-response.schema.json",
  "title": "Tutor Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "message", "suggested_next_step"],
  "properties": {
    "intent": {"enum": ["question", "hint", "explain", "reflect"]},
    "message": {"type": "string", "minLength": 1},
    "suggested_next_step": {"type": ["string", "null"]}
  }
}
