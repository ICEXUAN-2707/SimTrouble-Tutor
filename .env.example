# Copy to .env.local for local-only configuration. Never commit a real API key.
SIMTROUBLE_LLM_ENABLED=false
SIMTROUBLE_LLM_PROVIDER=deepseek
SIMTROUBLE_LLM_MODEL=deepseek-flash
SIMTROUBLE_LLM_BASE_URL=https://api.deepseek.com
SIMTROUBLE_LLM_TIMEOUT_SECONDS=8
SIMTROUBLE_LLM_MAX_RETRIES=1
DEEPSEEK_API_KEY=
# For the other built-in providers, set the matching provider ID above and its key:
# SIMTROUBLE_LLM_PROVIDER=qwen; DASHSCOPE_API_KEY=
# SIMTROUBLE_LLM_PROVIDER=kimi; MOONSHOT_API_KEY=
# SIMTROUBLE_LLM_PROVIDER=siliconflow; SILICONFLOW_API_KEY=
